# Copy this file to .env and fill in real values. .env is gitignored — see
# /.gitignore — so this file is what documents which variables the app needs.

# Mammogram demo
VITE_EMAILJS_SERVICE_ID_MAMMO=
VITE_EMAILJS_TEMPLATE_ID_MAMMO=

# Liquid Biopsy demo
VITE_EMAILJS_SERVICE_ID_LB=
VITE_EMAILJS_TEMPLATE_ID_LB=

# Shared public key
VITE_EMAILJS_PUBLIC_KEY=

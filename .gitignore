# ─────────────────────────────────────────────────────────────────────────────
# SHRI-AI — one root .gitignore for the whole repository.
#
# What is committed:
#   client/          the website (React + Vite)
#   client/dist/     the built site — tracked on purpose, see "Build output"
#
# Patterns without a leading slash match at any depth.
# ─────────────────────────────────────────────────────────────────────────────


# ── Unused files ──
# Everything the website does not use: original/source images, design
# exports, retired components and documents. Kept on disk for reference,
# never pushed.
/UN_USED_FILES/


# ── Dependencies ──
# Rebuilt from package-lock.json by `npm ci`; the lockfile stays committed.
node_modules/
jspm_packages/


# ── Build output ──
# client/dist/ is deliberately committed: the site is deployed by copying the
# built output straight to the web server, with no build step there. Only
# tool caches are ignored.
.vite/
*.tsbuildinfo
*.local


# ── Environment files ──
# May hold credentials. Commit a *.env.example template instead.
.env
.env.*
!.env.example


# ── Logs, caches and coverage ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
.cache/
coverage/
.nyc_output/


# ── Editors and tools ──
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
# Claude Code local session settings
.claude/


# ── OS files ──
.DS_Store
._*
Thumbs.db
Desktop.ini
# Image-viewer metadata sidecars (these once slipped into client/public/)
.comments/
